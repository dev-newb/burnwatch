{
  "name": "claude-usage-widget",
  "version": "2.7.0",
  "description": "Burnwatch \u2014 desktop widget tracking AI usage across Anthropic, OpenAI and Google",
  "main": "start.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "claude",
    "usage",
    "widget",
    "electron"
  ],
  "author": "devnewb",
  "license": "MIT",
  "copyright": "Copyright \u00a9 2026 Burnwatch (dev-newb). Based on Claude Usage Widget \u00a9 Slavomir Durej (MIT).",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  },
  "build": {
    "appId": "com.burnwatch.app",
    "productName": "I'm Burning!",
    "copyright": "Copyright \u00a9 2026 Burnwatch (dev-newb) \u00b7 based on Claude Usage Widget \u00a9 Slavomir Durej",
    "publish": [
      {
        "provider": "github",
        "owner": "dev-newb",
        "repo": "imburning-electron"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ImBurning-${version}-win-portable.${ext}",
      "unpackDirName": "claude-usage-widget"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ImBurning-${version}-win-Setup.${ext}"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.md",
      "!test/**",
      "!tools/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/burning-robot.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright \u00a9 2026 Burnwatch (dev-newb) \u00b7 based on Claude Usage Widget \u00a9 Slavomir Durej"
      }
    },
    "dmg": {
      "artifactName": "ImBurning-${version}-macOS-${arch}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/logo.png",
      "category": "Utility",
      "artifactName": "ImBurning-${version}-linux-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/dev-newb/imburning-electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-newb/imburning-electron.git"
  }
}
